# Copier ce fichier en .env (jamais publié sur GitHub) et le compléter.

# Fournisseur : mistral, anthropic, openai, ollama ou simule (test sans clé)
FOURNISSEUR_IA=mistral

# Facultatif : nom exact du modèle (sinon valeur par défaut du code)
# Offre gratuite Mistral : vérifier les modèles disponibles sur la page « Limites »
# MODELE_IA=mistral-large-4
# DELAI_ENTRE_APPELS=8      # secondes entre deux appels (limite de tokens par minute)
# DELAI_MAX_REPONSE=180     # attente maximale d'une réponse

# Une seule clé suffit, celle du fournisseur choisi
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modèle local (Ollama)
# OLLAMA_URL=http://localhost:11434
